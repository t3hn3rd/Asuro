OUTPUT_FORMAT(elf64-x86-64)
ENTRY(loader)
SECTIONS
{
    /* Bootstrap-only low mapping. Final kernel address-space policy is a
       separate milestone; do not inherit the i386 0xC0000000 offset. */
    . = 0x100000;
    kernel_start = .;
    .multiboot : { KEEP(*(.multiboot)) }
    .text ALIGN(4096) : { *(.text .text.*) }
    .rodata ALIGN(4096) : { *(.rodata .rodata.*) }
    .data ALIGN(4096) : { *(.data .data.*) }
    load_end = .;
    .bss ALIGN(4096) (NOLOAD) : { *(COMMON) *(.bss .bss.*) }
    . = ALIGN(4096);
    kernel_end = .;
    ASSERT(kernel_end < 0x100000000, "Bootstrap must fit below 4 GiB")
    /DISCARD/ : { *(.comment) *(.note*) *(.eh_frame*) }
}
